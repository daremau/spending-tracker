# Database (for local dev only - Docker uses its own DATABASE_URL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/spending_tracker?schema=public"

# NextAuth
# For production: use your VM's public IP or domain (e.g., http://123.45.67.89)
NEXTAUTH_URL="http://localhost:3000"

# Generate a secure secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-change-in-production"

# Portfolio routes and navigation.
# Set to true to show Portfolio. Setting it back to false only hides the entry
# points; no portfolio data is deleted.
PORTFOLIO_ENABLED=false

# Optional automatic market data (server-only).
# Leave TWELVE_DATA_API_KEY empty to run the portfolio entirely on manual
# assets, prices, and exchange rates. This key is never sent to the browser.
MARKET_DATA_PROVIDER=twelve-data
TWELVE_DATA_API_KEY=
MARKET_DATA_TIMEOUT_MS=8000

# Required only for POST /api/cron/portfolio-quotes.
# Generate with: openssl rand -base64 32
# The route rejects any request without this exact bearer token.
PORTFOLIO_REFRESH_SECRET=

# Chatbot IA (BYOK, server-only).
# Clave para cifrar la API key del chatbot en reposo (AES-256-GCM).
CHATBOT_KEY_SECRET=
# Defaults (overridable desde la UI del chatbot):
# CHATBOT_BASE_URL=https://ollama.com/v1
# CHATBOT_MODEL=qwen3-vl:235b-cloud
# CHATBOT_FALLBACK_MODEL=gpt-oss:20b-cloud
